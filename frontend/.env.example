# API Configuration
# Base URL of the backend REST API (backend listens on :5000 by default).
VITE_API_BASE_URL=http://localhost:5000/api

# To test against a deployed backend instead of a local one, set
# VITE_API_BASE_URL=/api and set VITE_PROXY_TARGET to the backend's origin.
# The Vite dev server will proxy /api requests there server-side, avoiding
# CORS. See vite.config.ts.
# VITE_PROXY_TARGET=https://the-chem-store-backend.onrender.com
